{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              [":PACKAGE:", "!@config", "!@/**", "!:STYLE:"],
              ":BLANK_LINE:",
              ["@/**", "@config", "!:STYLE:"],
              ":BLANK_LINE:",
              ["../**", "!:STYLE:"],
              ":BLANK_LINE:",
              ["./**", "!:STYLE:"],
              ["**", "!:STYLE:"],
              ":BLANK_LINE:",
              ":STYLE:"
            ],
            "sortBareImports": true
          }
        },
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/storybook-static",
      "!!demo/public",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "useBlockStatements": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["vite.config.ts", "**/*.stories.tsx", ".storybook/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/lib/utils/**/*.ts", "src/pages/**/utils/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentArrowReturn": {
              "level": "error",
              "options": {
                "style": "always"
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/services",
                      "@/services/**",
                      "@/store",
                      "@/store/**",
                      "@/app",
                      "@/app/**",
                      "@/components/business",
                      "@/components/business/**",
                      "**/services",
                      "**/services/**",
                      "**/store",
                      "**/store/**",
                      "**/app",
                      "**/app/**",
                      "@/pages",
                      "@/pages/**",
                      "**/pages",
                      "**/pages/**",
                      "@/routes",
                      "@/routes/**",
                      "**/routes",
                      "**/routes/**",
                      "**/business",
                      "**/business/**"
                    ],
                    "message": "UI не зависит от сервисов, состояния приложения или бизнес-сценариев."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/services/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/components",
                      "@/components/**",
                      "@/store",
                      "@/store/**",
                      "**/app",
                      "**/app/**",
                      "@/pages",
                      "@/pages/**",
                      "**/pages",
                      "**/pages/**",
                      "@/routes",
                      "@/routes/**",
                      "**/routes",
                      "**/routes/**",
                      "**/components",
                      "**/components/**",
                      "**/store",
                      "**/store/**"
                    ],
                    "message": "Services не зависят от app, components и store."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
